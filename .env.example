# Grazia Stones - Environment Variables
# Copy this to .env and fill in your actual values

# ═══════════════════════════════════════════════════════════════════════
# BACKEND API
# ═══════════════════════════════════════════════════════════════════════
API_BASE_URL=https://api.graziastones.com/v1
API_BASE_URL_DEV=http://localhost:3000/api/v1

# ═══════════════════════════════════════════════════════════════════════
# FIREBASE (Get from Firebase Console)
# ═══════════════════════════════════════════════════════════════════════
# Android
FIREBASE_ANDROID_API_KEY=your_android_api_key_here
FIREBASE_ANDROID_APP_ID=1:your_project_number:android:your_app_id
FIREBASE_MESSAGING_SENDER_ID=your_sender_id
FIREBASE_PROJECT_ID=grazia-stones
FIREBASE_STORAGE_BUCKET=grazia-stones.appspot.com

# iOS
FIREBASE_IOS_API_KEY=your_ios_api_key_here
FIREBASE_IOS_APP_ID=1:your_project_number:ios:your_app_id
FIREBASE_IOS_BUNDLE_ID=com.grazia.stones

# Web
FIREBASE_WEB_API_KEY=your_web_api_key_here
FIREBASE_WEB_APP_ID=1:your_project_number:web:your_app_id
FIREBASE_AUTH_DOMAIN=grazia-stones.firebaseapp.com

# ═══════════════════════════════════════════════════════════════════════
# RAZORPAY (Get from Razorpay Dashboard)
# ═══════════════════════════════════════════════════════════════════════
RAZORPAY_KEY_ID_TEST=rzp_test_your_key_id_here
RAZORPAY_KEY_SECRET_TEST=your_key_secret_here
RAZORPAY_KEY_ID_LIVE=rzp_live_your_key_id_here
RAZORPAY_KEY_SECRET_LIVE=your_key_secret_here

# ═══════════════════════════════════════════════════════════════════════
# IMAGE CDN (Cloudinary or AWS S3)
# ═══════════════════════════════════════════════════════════════════════
CDN_BASE_URL=https://res.cloudinary.com/grazia-stones/
CDN_CLOUD_NAME=grazia-stones
CDN_API_KEY=your_cloudinary_api_key
CDN_API_SECRET=your_cloudinary_api_secret

# Or AWS S3
# AWS_S3_BUCKET=grazia-stones-media
# AWS_REGION=ap-south-1
# AWS_ACCESS_KEY_ID=your_access_key
# AWS_SECRET_ACCESS_KEY=your_secret_key

# ═══════════════════════════════════════════════════════════════════════
# ANALYTICS & MONITORING
# ═══════════════════════════════════════════════════════════════════════
SENTRY_DSN=https://your_sentry_dsn@sentry.io/project_id
MIXPANEL_TOKEN=your_mixpanel_token

# ═══════════════════════════════════════════════════════════════════════
# GOOGLE MAPS (For dealer locator)
# ═══════════════════════════════════════════════════════════════════════
GOOGLE_MAPS_API_KEY_ANDROID=your_android_maps_key
GOOGLE_MAPS_API_KEY_IOS=your_ios_maps_key
GOOGLE_MAPS_API_KEY_WEB=your_web_maps_key

# ═══════════════════════════════════════════════════════════════════════
# FEATURE FLAGS
# ═══════════════════════════════════════════════════════════════════════
ENABLE_AI_VISUALIZATION=true
ENABLE_AR_VIEW=true
ENABLE_MOCK_DATA=false
ENABLE_DEBUG_LOGS=true

# ═══════════════════════════════════════════════════════════════════════
# APP CONFIGURATION
# ═══════════════════════════════════════════════════════════════════════
APP_NAME=Grazia Stones
APP_VERSION=1.0.0
MIN_ANDROID_SDK=21
TARGET_ANDROID_SDK=34
IOS_DEPLOYMENT_TARGET=12.0
