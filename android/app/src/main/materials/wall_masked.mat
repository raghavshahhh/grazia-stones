// Stone cladding clipped to the wall pixels found by the on-device wall segmenter.
// Compile: matc -p mobile -a opengl -o android/app/src/main/assets/materials/wall_masked.filamat wall_masked.mat
// (matc 1.56.0, the Filament version SceneView 2.3.0 ships.)
material {
    name : grazia_wall_masked,
    shadingModel : lit,
    blending : transparent,
    doubleSided : true,
    requires : [ uv0 ],
    parameters : [
        { type : sampler2d, name : baseColorMap },
        { type : sampler2d, name : normalMap },
        // Wall probability in VIEW space (0..1, row 0 = top of the screen), from the segmenter.
        { type : sampler2d, name : maskMap },
        // Camera view-projection at the moment that mask's camera frame was captured. Each fragment is
        // projected through it, so the mask stays locked to the room while the phone moves.
        { type : mat4, name : maskViewProj },
        // 1 = clip to the mask, 0 = ignore it (segmenter not ready yet).
        { type : float, name : useMask },
        { type : float, name : emissiveLevel }
    ]
}

fragment {
    void material(inout MaterialInputs material) {
        float2 uv = getUV0();
        material.normal = texture(materialParams_normalMap, uv).xyz * 2.0 - 1.0;
        prepareMaterial(material);
        float4 base = texture(materialParams_baseColorMap, uv);
        float4 clip = materialParams.maskViewProj * float4(getUserWorldPosition(), 1.0);
        float wall = 0.0; // outside the last analysed view: unknown, keep hidden until the next mask
        if (clip.w > 0.0) {
            float2 ndc = clip.xy / clip.w;
            float2 muv = float2(ndc.x * 0.5 + 0.5, 0.5 - ndc.y * 0.5);
            if (muv.x >= 0.0 && muv.x <= 1.0 && muv.y >= 0.0 && muv.y <= 1.0) {
                wall = texture(materialParams_maskMap, muv).r;
            }
        }
        float a = mix(1.0, smoothstep(0.4, 0.6, wall), materialParams.useMask);
        material.baseColor = float4(base.rgb * a, a);
        material.roughness = 0.85;
        material.metallic = 0.0;
        material.emissive = float4(base.rgb * materialParams.emissiveLevel * a, 0.0);
    }
}
