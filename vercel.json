{
  "version": 2,
  "outputDirectory": "build/web",
  "functions": {
    "api/generate-visualization.js": { "maxDuration": 180 },
    "api/aarna.js": { "maxDuration": 90 }
  },
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "/api/$1"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
