# Exclude large directories
.claude
.cursor
.dart_tool
.github
.idea
.impeccable
.metadata
.remember
.swc
.vercel
android
ios
linux
macos
windows
docs
scripts
training-data
graphify-out
*.sh
*.yaml
*.lock
Dockerfile*
docker-compose*
nginx.conf
deploy.sh
production-deploy.sh
push-to-github.sh
setup.sh
start.sh
README.md

# NOTE: do NOT blanket-ignore *.json or *.md or vercel.json here.
# build/web/manifest.json, build/web/assets/AssetManifest.bin.json, and
# build/web/assets/FontManifest.json are required at runtime by the Flutter
# web app — a previous *.json rule silently broke the PWA manifest and font
# loading in production (manifest.json was falling through to the SPA
# index.html fallback instead of being served as JSON).
